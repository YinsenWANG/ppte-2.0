{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppte.dev/schemas/1.0/presentation-ir.schema.json",
  "title": "PPTe Presentation IR 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["irVersion", "title", "narrative", "slides"],
  "properties": {
    "irVersion": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "audience": { "type": "string", "maxLength": 4096 },
    "objective": { "type": "string", "maxLength": 4096 },
    "narrative": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "slideKeys"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "title": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "message": { "type": "string", "maxLength": 4096 },
          "slideKeys": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } }
        }
      }
    },
    "slides": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "slide-ir.schema.json" } },
    "themeIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tone": { "enum": ["formal", "modern", "editorial", "technical", "playful"] },
        "density": { "enum": ["low", "medium", "high"] },
        "brandKeywords": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "preferredColors": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "avoidColors": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } }
      }
    },
    "sourceIds": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } }
  }
}
