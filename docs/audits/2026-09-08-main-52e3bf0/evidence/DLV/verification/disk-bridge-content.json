:1px solid #b9bcb5}.statement .body-copy{font-size:22px}.steps{list-style:none;padding:0;margin:30px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:28px 64px}.steps li{display:grid;grid-template-columns:42px 1fr;gap:12px;border-top:1px solid #b9bcb5;padding-top:18px}.steps .num{font-size:17px;color:#b84930}.steps h3{font-size:25px;font-weight:600}.steps p{font-size:19px;line-height:1.65;margin-top:10px;color:#475451}.example{display:grid;grid-template-columns:360px 1fr;gap:65px;padding-top:28px}.example h2{margin-top:22px}.example-panel{border-left:3px solid #b84930;padding:8px 0 0 30px}.example-panel h3{font-size:26px;margin:15px 0 23px}.example-panel dl{margin:0}.example-panel dt{font-size:14px;color:#b84930;margin-top:20px}.example-panel dd{font-size:21px;line-height:1.6;margin:6px 0 0}.closing{padding-top:32px}.closing h2{font-size:72px;line-height:1.35;margin-top:24px}.closing h2 em{font-style:normal;color:#b84930}.sources{display:flex;gap:48px;border-top:1px solid #b9bcb5;margin-top:40px;padding-top:22px;font-size:17px;line-height:1.8}.sources a{color:#242c2e;text-underline-offset:5px}.sources p{font-size:14px;color:#5b6664;max-width:440px}\n</style></head><body data-ppte-id=\"ppte-3\">\n<section class=\"page\" data-ppte-slide=\"ppte-4\" data-ppte-id=\"ppte-4\"><header class=\"mast\" data-ppte-id=\"ppte-5\"><span class=\"brand\" data-ppte-id=\"ppte-6\">CHERRY STUDIO</span><span class=\"issue\" data-ppte-id=\"ppte-7\">产品与社区 / 开源参与导览</span></header><main class=\"cover-body\" data-ppte-id=\"ppte-8\"><div data-ppte-id=\"ppte-9\"><p class=\"kicker\" data-ppte-id=\"ppte-10\">从一个桌面入口，到共同建设</p><h1 class=\"cover-title\" data-ppte-id=\"u01-cover-title\">开源之路 · 一起参与</h1><p class=\"cover-deck\" data-ppte-id=\"ppte-13\">工具连接模型。<br data-ppte-id=\"ppte-14\">开放，让使用者也能参与改变工具。</p></div><aside class=\"cover-aside\" data-ppte-id=\"ppte-15\"><p class=\"aside-title\" data-ppte-id=\"ppte-16\">Cherry Studio<br data-ppte-id=\"ppte-17\">多模型 AI 桌面客户端</p><ol class=\"contents\" data-ppte-id=\"ppte-18\"><li data-ppte-id=\"ppte-19\"><span data-ppte-id=\"ppte-20\">01</span>选择自己的工具</li><li data-ppte-id=\"ppte-21\"><span data-ppte-id=\"ppte-22\">02</span>找到参与的位置</li><li data-ppte-id=\"ppte-23\"><span data-ppte-id=\"ppte-24\">03</span>完成一次小贡献</li></ol></aside></main><footer class=\"folio\" data-ppte-id=\"ppte-25\"><span data-ppte-id=\"ppte-26\">基于项目固定版本资料 · 不含实时增长统计</span><span data-ppte-id=\"ppte-27\">01 / 09</span></footer><div data-ppte-id=\"frame-image-b97b50de-b75f-440f-aad0-8046af6c014a\" data-ppte-image-frame=\"{&quot;x&quot;:890.8571428571429,&quot;y&quot;:195.57142857142858,&quot;w&quot;:291.69731418949647,&quot;h&quot;:159.8472063235983,&quot;iw&quot;:355.98302847521074,&quot;ih&quot;:195.56149203788402,&quot;ox&quot;:-17.142857142857142,&quot;oy&quot;:-11.428571428571429}\" style=\"position: absolute !important; left: 890.857px !important; top: 195.571px !important; width: 291.697px !important; height: 159.847px !important; overflow: clip !important; margin: 0px !important; padding: 0px !important; border: 0px !important; box-sizing: border-box !important;\"><img data-ppte-id=\"image-b97b50de-b75f-440f-aad0-8046af6c014a\" src=\"data:image/png;base64,\" alt=\"\" style=\"position: absolute !important; left: -17.1429px !important; top: -11.4286px !important; width: 355.983px !important; height: 195.561px !important; max-width: none !important; max-height: none !important; min-width: 0px !important; min-height: 0px !important; margin: 0px !important; padding: 0px !important; border: 0px !important; transform: none !important; object-fit: fill !important; opacity: 1 !important; filter: none !important; border-radius: 0px !important;\"></div></section>\n<section class=\"page\" data-ppte-slide=\"ppte-28\" data-ppte-id=\"ppte-28\"><header class=\"mast\" data-ppte-id=\"ppte-29\"><span class=\"brand\" data-ppte-id=\"ppte-30\">CHERRY STUDIO</span><span class=\"issue\" data-ppte-id=\"ppte-31\">工具 / 先理解它的位置</span></header><main class=\"chapter\" data-ppte-id=\"ppte-32\"><p class=\"kicker\" data-ppte-id=\"ppte-33\">01 / 选择自己的工具</p><h2 data-ppte-id=\"ppte-34\">一个桌面入口，连接多种模型。</h2><p class=\"wide-lead\" data-ppte-id=\"ppte-35\">Cherry Studio 是支持多家大语言模型提供商的桌面客户端，<br data-ppte-id=\"ppte-36\">可运行于 Windows、macOS 与 Linux。</p><div class=\"two-notes\" data-ppte-id=\"ppte-37\"><div class=\"note-block\" data-ppte-id=\"ppte-38\"><h3 data-ppte-id=\"ppte-39\">连接模型</h3><p data-ppte-id=\"ppte-40\">固定版本资料列出云端服务接入，<br data-ppte-id=\"ppte-41\">也列出 Ollama、LM Studio 本地模型支持。</p></div><div class=\"note-block\" data-ppte-id=\"ppte-42\"><h3 data-ppte-id=\"ppte-43\">组织使用</h3><p data-ppte-id=\"ppte-44\">围绕助手、对话与主题管理组织工作，<br data-ppte-id=\"ppte-45\">把模型能力带入具体的使用场景。</p></div></div></main><footer class=\"folio\" data-ppte-id=\"ppte-46\"><span data-ppte-id=\"ppte-47\">来源：CherryHQ/cherry-studio · README · 固定版本 67ca175 / Introduction、Key Features</span><span data-ppte-id=\"ppte-48\">02 / 09</span></footer></section>\n<section class=\"page\" data-ppte-slide=\"ppte-49\" data-ppte-id=\"ppte-49\"><header class=\"mast\" data-ppte-id=\"ppte-50\"><span class=\"brand\" data-ppte-id=\"ppte-51\">CHERRY STUDIO</span><span class=\"issue\" data-ppte-id=\"ppte-52\">开放 / 使用经验也是起点</span></header><main class=\"statement\" data-ppte-id=\"ppte-53\"><div data-ppte-id=\"ppte-54\"><p class=\"kicker\" data-ppte-id=\"ppte-55\">从个人体验出发</p><h2 data-ppte-id=\"ppte-56\">先用起来。<br data-ppte-id=\"ppte-57\">再说清楚。</h2></div><div data-ppte-id=\"ppte-58\"><p class=\"large-copy\" data-ppte-id=\"ppte-59\">你在使用中遇到的一个障碍，<br data-ppte-id=\"ppte-60\">可能就是参与的起点。</p><p class=\"body-copy\" data-ppte-id=\"ppte-61\">先说明自己想完成什么，再记录哪里受阻。<br data-ppte-id=\"ppte-62\">把“感觉不好用”转成可以讨论的具体场景，<br data-ppte-id=\"ppte-63\">让其他人理解问题，也让改进有据可循。</p><p class=\"small-note\" data-ppte-id=\"ppte-64\">这是一种参与思路，并非官方处理时限或采纳承诺。</p></div></main><footer class=\"folio\" data-ppte-id=\"ppte-65\"><span data-ppte-id=\"ppte-66\">作者参与建议 · 具体要求以项目贡献指南为准</span><span data-ppte-id=\"ppte-67\">03 / 09</span></footer></section>\n<section class=\"page\" data-ppte-slide=\"ppte-68\" data-ppte-id=\"ppte-68\"><header class=\"mast\" data-ppte-id=\"ppte-69\"><span class=\"brand\" data-ppte-id=\"ppte-70\">CHERRY STUDIO</span><span class=\"issue\" data-ppte-id=\"ppte-71\">参与 / 多条路径，同一方向</span></header><main class=\"split-body\" data-ppte-id=\"ppte-72\"><div data-ppte-id=\"ppte-73\"><p class=\"kicker\" data-ppte-id=\"ppte-74\">从使用者到共建者</p><h2 data-ppte-id=\"ppte-75\">写代码，<br data-ppte-id=\"ppte-76\">只是其中一条路。</h2><p class=\"body-copy\" data-ppte-id=\"ppte-77\">项目也欢迎设计讨论、文档维护、问题管理与社区答疑。<br data-ppte-id=\"ppte-78\">从自己的经验出发，就能找到一个具体的切入点。</p><p class=\"small-note\" data-ppte-id=\"ppte-79\">这里呈现的是参与关系，<br data-ppte-id=\"ppte-80\">并非项目实际开发流程或贡献统计。</p></div><figure data-ppte-id=\"ppte-81\"><div class=\"diagram-labels\" data-ppte-id=\"ppte-82\"><span data-ppte-id=\"ppte-83\">反馈</span><span data-ppte-id=\"ppte-84\">代码</span><span data-ppte-id=\"ppte-85\">文档</span></div><img class=\"diagram-image\" src=\"data:image/svg+xml;base64,\" alt=\"三条独立路径在中央汇合，象征反馈、代码与文档共同完善产品\" data-ppte-id=\"ppte-86\"><figcaption class=\"diagram-caption\" data-ppte-id=\"ppte-87\"><strong data-ppte-id=\"ppte-88\">共同维护，持续完善</strong><span data-ppte-id=\"ppte-89\">原创概念图 · 非产品截图</span></figcaption></figure></main><footer class=\"folio\" data-ppte-id=\"ppte-90\"><span data-ppte-id=\"ppte-91\">来源：CherryHQ/cherry-studio · README / Contributing · 固定版本 67ca175</span><span data-ppte-id=\"ppte-92\">04 / 09</span></footer></section>\n<section class=\"page\" data-ppte-slide=\"ppte-93\" data-ppte-id=\"ppte-93\"><header class=\"mast\" data-ppte-id=\"ppte-94\"><span class=\"brand\" data-ppte-id=\"ppte-95\">CHERRY STUDIO</span><span class=\"issue\" data-ppte-id=\"ppte-96\">反馈 / 把体验变成可讨论的信息</span></header><main class=\"example\" data-ppte-id=\"ppte-97\"><div data-ppte-id=\"ppte-98\"><p class=\"kicker\" data-ppte-id=\"ppte-99\">让别人能重走你的路径</p><h2 data-ppte-id=\"ppte-100\">一份反馈，<br data-ppte-id=\"ppte-101\">先把问题讲清。</h2><p class=\"body-copy\" data-ppte-id=\"ppte-102\">不用先知道修复答案。<br data-ppte-id=\"ppte-103\">清楚的上下文，已经能减少来回追问。</p><p class=\"small-note\" data-ppte-id=\"ppte-104\">右侧为虚构写作示例，<br data-ppte-id=\"ppte-105\">不代表已发现的产品缺陷。</p></div><div class=\"example-panel\" data-ppte-id=\"ppte-106\"><p class=\"kicker\" data-ppte-id=\"ppte-107\">反馈写作示例 · 非真实缺陷</p><h3 data-ppte-id=\"ppte-108\">某个操作后，结果与预期不同</h3><dl data-ppte-id=\"ppte-109\"><dt data-ppte-id=\"ppte-110\">场景与步骤</dt><dd data-ppte-id=\"ppte-111\">我想完成什么？从哪个页面开始？<br data-ppte-id=\"ppte-112\">按顺序列出触发问题的操作。</dd><dt data-ppte-id=\"ppte-113\">预期与实际</dt><dd data-ppte-id=\"ppte-114\">我以为会出现什么？实际出现了什么？<br data-ppte-id=\"ppte-115\">补充可以帮助定位的环境与版本。</dd><dt data-ppte-id=\"ppte-116\">可复现的边界</dt><dd data-ppte-id=\"ppte-117\">每次都出现，还是偶尔发生？<br data-ppte-id=\"ppte-118\">如需附素材，先去除其中的私人信息。</dd></dl></div></main><footer class=\"folio\" data-ppte-id=\"ppte-119\"><span data-ppte-id=\"ppte-120\">作者参与建议 · 具体要求以项目贡献指南为准</span><span data-ppte-id=\"ppte-121\">05 / 09</span></footer></section>\n<section class=\"page\" data-ppte-slide=\"ppte-122\" data-ppte-id=\"ppte-122\"><header class=\"mast\" data-ppte-id=\"ppte-123\"><span class=\"brand\" data-ppte-id=\"ppte-124\">CHERRY STUDIO</span><span class=\"issue\" data-ppte-id=\"ppte-125\">协作 / 让一次修改容易理解</span></header><main class=\"chapter\" data-ppte-id=\"ppte-126\"><p class=\"kicker\" data-ppte-id=\"ppte-127\">把改动交给共同维护</p><h2 data-ppte-id=\"ppte-128\">从独立分支，到一个清楚的 PR。</h2><ol class=\"steps\" data-ppte-id=\"ppte-129\"><li data-ppte-id=\"ppte-130\"><span class=\"num\" data-ppte-id=\"ppte-131\">01</span><div data-ppte-id=\"ppte-132\"><h3 data-ppte-id=\"ppte-133\">Fork 与克隆</h3><p data-ppte-id=\"ppte-134\">建立自己的工作副本，<br data-ppte-id=\"ppte-135\">先阅读贡献指南与分支策略。</p></div></li><li data-ppte-id=\"ppte-136\"><span class=\"num\" data-ppte-id=\"ppte-137\">02</span><div data-ppte-id=\"ppte-138\"><h3 data-ppte-id=\"ppte-139\">创建分支</h3><p data-ppte-id=\"ppte-140\">围绕一个明确的问题组织改动，<br data-ppte-id=\"ppte-141\">保持范围便于解释与审阅。</p></div></li><li data-ppte-id=\"ppte-142\"><span class=\"num\" data-ppte-id=\"ppte-143\">03</span><div data-ppte-id=\"ppte-144\"><h3 data-ppte-id=\"ppte-145\">提交修改</h3><p data-ppte-id=\"ppte-146\">完成修改并提交、推送，<br data-ppte-id=\"ppte-147\">交代做了什么以及如何验证。</p></div></li><li data-ppte-id=\"ppte-148\"><span class=\"num\" data-ppte-id=\"ppte-149\">04</span><div data-ppte-id=\"ppte-150\"><h3 data-ppte-id=\"ppte-151\">发起 Pull Request</h3><p data-ppte-id=\"ppte-152\">说明修改的原因，<br data-ppte-id=\"ppte-153\">跟进讨论并补充必要的信息。</p></div></li></ol></main><footer class=\"folio\" data-ppte-id=\"ppte-154\"><span data-ppte-id=\"ppte-155\">来源：CherryHQ/cherry-studio · README · 固定版本 67ca175 / Getting Started；范围与验证为作者建议</span><span data-ppte-id=\"ppte-156\">06 / 09</span></footer></section>\n<section class=\"page\" data-ppte-slide=\"ppte-157\" data-ppte-id=\"ppte-157\"><header class=\"mast\" data-ppte-id=\"ppte-158\"><span class=\"brand\" data-ppte-id=\"ppte-159\">CHERRY STUDIO</span><span class=\"issue\" data-ppte-id=\"ppte-160\">行动 / 一次小而完整的贡献</span></header><main class=\"dense-body\" data-ppte-id=\"ppte-161\"><div class=\"dense-heading\" data-ppte-id=\"ppte-162\"><div data-ppte-id=\"ppte-163\"><p class=\"kicker\" data-ppte-id=\"ppte-164\">把参与变成可执行的下一步</p><h2 data-ppte-id=\"ppte-165\">从你最了解的那个问题开始。</h2></div><p data-ppte-id=\"ppte-166\">下列是作者的参与建议，<br data-ppte-id=\"ppte-167\">具体要求以项目贡献指南为准。</p></div><table class=\"contribution-table\" data-ppte-id=\"ppte-168\"><thead data-ppte-id=\"ppte-169\"><tr data-ppte-id=\"ppte-170\"><th scope=\"col\" data-ppte-id=\"ppte-171\">你看到的机会</th><th scope=\"col\" data-ppte-id=\"ppte-172\">可以做的一件事</th><th scope=\"col\" data-ppte-id=\"ppte-173\">让协作者容易接手</th></tr></thead><tbody data-ppte-id=\"ppte-174\"><tr data-ppte-id=\"ppte-175\"><td data-ppte-id=\"ppte-176\"><span class=\"row-num\" data-ppte-id=\"ppte-177\">01</span>使用中遇到障碍</td><td data-ppte-id=\"ppte-178\">把问题整理为可复现的反馈</td><td data-ppte-id=\"ppte-179\">写明操作步骤、预期与实际结果</td></tr><tr data-ppte-id=\"ppte-180\"><td data-ppte-id=\"ppte-181\"><span class=\"row-num\" data-ppte-id=\"ppte-182\">02</span>说明不够清楚</td><td data-ppte-id=\"ppte-183\">补充一段文档或一个具体例子</td><td data-ppte-id=\"ppte-184\">说明适用场景，核对步骤是否可用</td></tr><tr data-ppte-id=\"ppte-185\"><td data-ppte-id=\"ppte-186\"><span class=\"row-num\" data-ppte-id=\"ppte-187\">03</span>交互可以更顺</td><td data-ppte-id=\"ppte-188\">在设计讨论中提出改进方案</td><td data-ppte-id=\"ppte-189\">带上使用场景，解释取舍与影响</td></tr><tr data-ppte-id=\"ppte-190\"><td data-ppte-id=\"ppte-191\"><span class=\"row-num\" data-ppte-id=\"ppte-192\">04</span>找到了修复方法</td><td data-ppte-id=\"ppte-193\">在独立分支完成修改并提交 PR</td><td data-ppte-id=\"ppte-194\">描述原因、改动与验证结果</td></tr></tbody></table><div class=\"next-step\" data-ppte-id=\"ppte-195\"><strong data-ppte-id=\"ppte-196\">先缩小范围</strong><span data-ppte-id=\"ppte-197\">选一个问题 → 读贡献指南 → 讨论或提交 → 跟进反馈</span></div></main><footer class=\"folio\" data-ppte-id=\"ppte-198\"><span data-ppte-id=\"ppte-199\">贡献入口依据固定 README；行动清单为作者建议，不代表官方流程承诺</span><span data-ppte-id=\"ppte-200\">07 / 09</span></footer></section>\n<section class=\"page\" data-ppte-slide=\"ppte-201\" data-ppte-id=\"ppte-201\"><header class=\"mast\" data-ppte-id=\"ppte-202\"><span class=\"brand\" data-ppte-id=\"ppte-203\">CHERRY STUDIO</span><span class=\"issue\" data-ppte-id=\"ppte-204\">持续 / 提交之后，协作仍在继续</span></header><main class=\"statement\" data-ppte-id=\"ppte-205\"><div data-ppte-id=\"ppte-206\"><p class=\"kicker\" data-ppte-id=\"ppte-207\">贡献不止于提交</p><h2 data-ppte-id=\"ppte-208\">留出空间，<br data-ppte-id=\"ppte-209\">接住反馈。</h2></div><div data-ppte-id=\"ppte-210\"><p class=\"large-copy\" data-ppte-id=\"ppte-211\">把讨论看作共同理解问题的过程。</p><div class=\"two-notes\" style=\"margin-top: 30px; gap: 35px;\" data-ppte-id=\"ppte-212\"><div class=\"note-block\" data-ppte-id=\"ppte-213\"><h3 data-ppte-id=\"ppte-214\">信息不够时</h3><p data-ppte-id=\"ppte-215\">补充复现步骤、例子或验证结果，帮助协作者缩小不确定性。</p></div><div class=\"note-block\" data-ppte-id=\"ppte-216\"><h3 data-ppte-id=\"ppte-217\">意见不同时</h3><p data-ppte-id=\"ppte-218\">回到使用场景，解释取舍；必要时把大方案拆成小改动。</p></div></div><p class=\"small-note\" data-ppte-id=\"ppte-219\">建议持续跟进，但不预设维护者的响应速度或合并结果。</p></div></main><footer class=\"folio\" data-ppte-id=\"ppte-220\"><span data-ppte-id=\"ppte-221\">作者参与建议 · 具体要求以项目贡献指南为准</span><span data-ppte-id=\"ppte-222\">08 / 09</span></footer></section>\n<section class=\"page\" data-ppte-slide=\"ppte-223\" data-ppte-id=\"ppte-223\"><header class=\"mast\" data-ppte-id=\"ppte-224\"><span class=\"brand\" data-ppte-id=\"ppte-225\">CHERRY STUDIO</span><span class=\"issue\" data-ppte-id=\"ppte-226\">下一步 / 从一个问题开始</span></header><main class=\"closing\" data-ppte-id=\"ppte-227\"><p class=\"kicker\" data-ppte-id=\"ppte-228\">03 / 完成一次小贡献</p><h2 data-ppte-id=\"ppte-229\">选一个你在意的问题。<br data-ppte-id=\"ppte-230\"><em data-ppte-id=\"ppte-231\">让下一步，具体一点。</em></h2><p class=\"body-copy\" data-ppte-id=\"ppte-232\">读一段指南，补一个例子，或写下一份清楚的反馈。<br data-ppte-id=\"ppte-233\">从自己能完成的范围开始，和社区一起向前。</p><div class=\"sources\" data-ppte-id=\"ppte-234\"><a href=\"https://github.com/CherryHQ/cherry-studio\" data-ppte-id=\"ppte-235\">项目仓库 ↗</a><a href=\"https://github.com/CherryHQ/cherry-studio/blob/67ca175cc833ba6a286464343f64ec1e426d443a/CONTRIBUTING.md\" data-ppte-id=\"ppte-236\">贡献指南 ↗</a><p data-ppte-id=\"ppte-237\">本稿事实依据固定 README 67ca175。<br data-ppte-id=\"ppte-238\">不含实时统计；参与建议与概念图均为作者表达。</p></div></main><footer class=\"folio\" data-ppte-id=\"ppte-239\"><span data-ppte-id=\"ppte-240\">资料：固定 README 的 Introduction / Key Features / Contributing / Getting Started</span><span data-ppte-id=\"ppte-241\">09 / 09</span></footer></section>\n</body></html>"
}
