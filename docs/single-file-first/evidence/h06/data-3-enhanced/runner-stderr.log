eight:600;color:var(--muted);font-size:14px;border-bottom:2px solid var(--ink);padding:9px 16px}td{padding:7px 16px;border-bottom:1px solid var(--line)}td:last-child,th:last-child{text-align:right;font-variant-numeric:tabular-nums}td:first-child{font-family:ui-monospace,SFMono-Regular,Consolas,monospace}tr:nth-child(even) td{background:#ffffff60}.table-wrap{display:grid;grid-template-columns:3fr 1fr;gap:35px}.aside{border-left:1px solid var(--line);padding-left:25px}.aside p{font-size:18px}.row{display:flex;align-items:center;gap:20px;margin-bottom:18px}.bar-label{width:320px;font:18px ui-monospace,monospace}.bar{height:25px;background:var(--accent)}.bar-value{font-size:22px;font-weight:600}.flow{display:grid;grid-template-columns:1fr 45px 1.2fr 45px 1fr;align-items:center;margin:22px 0}.arrow{text-align:center;font-size:32px;color:var(--accent)}.flow .card{min-height:150px}.index{font-size:15px;color:var(--accent);margin-bottom:12px}.rule{border-top:1px solid var(--line);padding-top:20px;margin-top:16px}.big-statement{font-size:44px;line-height:1.45;max-width:1010px;margin:22px 0}.pill{display:inline-block;padding:5px 10px;border:1px solid var(--accent);font-size:13px;color:var(--accent);margin-bottom:14px}
