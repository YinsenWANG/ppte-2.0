</section>
</main>

<nav id="deck-controls" aria-label="本介绍稿导航">
<button type="button" id="prev" aria-label="上一页">←</button>
<span id="counter" aria-live="polite">1 / 12</span>
<button type="button" id="next" aria-label="下一页">→</button>
<button type="button" id="present" title="进入放映；方向键翻页，B 黑屏，Esc 退出">放映本稿</button>
</nav>
<div id="blackout" aria-label="黑屏；按 B 恢复或 Esc 退出"></div>
<script>
(function(){
"use strict";
const slides=Array.from(document.querySelectorAll("main > .slide"));
const counter=document.getElementById("counter");
const toggle=document.getElementById("present");
const controls=document.getElementById("deck-controls");
let current=0,presenting=false,idle;
function paint(){counter.textContent=(current+1)+" / "+slides.length;slides.forEach((s,i)=>s.classList.toggle("current",i===current));}
function go(n){current=Math.max(0,Math.min(slides.length-1,n));paint();if(!presenting)slides[current].scrollIntoView({behavior:"smooth",block:"start"});wake();}
function wake(){document.body.classList.remove("quiet");clearTimeout(idle);if(presenting)idle=setTimeout(()=>{if(!controls.contains(document.activeElement))document.body.classList.add("quiet");},2400);}
function enter(){presenting=true;document.body.classList.add("presenting");toggle.textContent="退出放映";paint();wake();}
function leave(){presenting=false;document.body.classList.remove("presenting","quiet","blacked");clearTimeout(idle);toggle.textContent="放映本稿";requestAnimationFrame(()=>slides[current].scrollIntoView({behavior:"instant",block:"start"}));}
document.getElementById("prev").addEventListener("click",()=>go(current-1));
document.getElementById("next").addEventListener("click",()=>go(current+1));
toggle.addEventListener("click",()=>presenting?leave():enter());
document.addEventListener("mousemove",wake,{passive:true});
document.addEventListener("touchstart",wake,{passive:true});
document.addEventListener("focusin",wake);
document.getElementById("blackout").addEventListener("click",()=>{document.body.classList.remove("blacked");wake();});
document.addEventListener("keydown",e=>{
if(e.key==="Escape"){if(presenting)leave();return;}
if(e.target.closest("button,input,textarea,select")&&[" ","Enter"].includes(e.key))return;
if(["ArrowRight","ArrowDown","PageDown"," "].includes(e.key)){e.preventDefault();go(current+1);}
else if(["ArrowLeft","ArrowUp","PageUp"].includes(e.key)){e.preventDefault();go(current-1);}
else if(e.key==="Home"){e.preventDefault();go(0);}
else if(e.key==="End"){e.preventDefault();go(slides.length-1);}
else if(presenting&&e.key.toLowerCase()==="b"){document.body.classList.toggle("blacked");wake();}
});
let queued=false;
window.addEventListener("scroll",()=>{if(presenting||queued)return;queued=true;requestAnimationFrame(()=>{queued=false;let best=Infinity;slides.forEach((s,i)=>{const r=s.getBoundingClientRect();const distance=Math.abs(r.top);if(distance<best){best=distance;current=i;}});paint();});},{passive:true});
paint();
})();
</script>
</body>
